# Copy to .env.local for development.
# Do NOT wrap values in quotes in the Vercel UI.

# Postgres (required)
# Example: postgresql://USER:PASSWORD@host/db?sslmode=require
DATABASE_URL=

# Clerk (required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Model providers
# OPENAI_API_KEY is enough for everything (chat + Consensus + RAG embeddings).
# Consensus panel: gpt-4o-mini, gpt-4o, gpt-4.1-mini → evaluator: gpt-4o
# RAG uses OpenAI text-embedding-3-small + pgvector on Postgres.
OPENAI_API_KEY=

# Optional — not required
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Tavily (optional — live web search in chat)
TAVILY_API_KEY=

# Upstash Redis (required in production for rate limits + cache)
# Without these on Vercel production, rate limiting fails closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Amazon S3 (preferred for uploads on Vercel / production)
# When set, PDFs/VTT/chat attachments go to this private bucket.
# Large source files upload browser→S3 via presigned PUT (bypasses Vercel’s 4.5MB body limit).
# Bucket CORS must allow PUT from your app origin, e.g.:
#   AllowedMethods: PUT, GET, HEAD
#   AllowedOrigins: https://YOUR_DOMAIN, http://localhost:3000
#   AllowedHeaders: *
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Vercel Blob (legacy fallback when S3 is not configured)
# Locally without S3 or Blob, files go under .data/uploads and /api/files/[id].
BLOB_READ_WRITE_TOKEN=

# Cron worker auth (required in production)
# Vercel Hobby: native Cron is once/day only — set this and point an external
# scheduler (cron-job.org, etc.) at GET /api/cron/jobs every 1–5 minutes with
# Authorization: Bearer $CRON_SECRET. after() + UI polling also drain the queue.
CRON_SECRET=

# Soft-deleted notebooks are hard-purged after this many days (default 30).
NOTEBOOK_PURGE_RETENTION_DAYS=30

# Authenticated load test (optional):
# SESSION_COOKIE=__session=...
# CONVERSATION_ID=...
# BASE_URL=http://localhost:3000

# Sentry (optional — exception capture on API routes)
SENTRY_DSN=

# Supadata (optional locally; required for YouTube sources on Vercel)
# YouTube blocks caption downloads from cloud IPs. Supadata free tier works.
# https://dash.supadata.ai → create key → paste here and in Vercel env.
SUPADATA_API_KEY=

# Set to true in CI when secrets are not available (lint/typecheck only).
SKIP_ENV_VALIDATION=
